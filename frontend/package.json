{
  "name": "certchain-frontend",
  "version": "2.0.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e.lifecycle.test.ts",
    "test:browser": "playwright test",
    "test:a11y": "playwright test tests/playwright/a11y.spec.ts",
    "test:load": "vitest run tests/load-endpoints.test.ts",
    "test:security-headers": "bash scripts/check-security-headers.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "indexer": "tsx --env-file=.env.local scripts/indexer.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "email-worker": "tsx --env-file=.env.local scripts/emailWorker.ts",
    "worker:pin-keeper": "tsx --env-file=.env.local worker/pinKeeper.ts",
    "db:schema": "bash scripts/build-schema.sh",
    "openapi:generate": "node scripts/check-openapi.mjs --generate",
    "openapi:check": "node scripts/check-openapi.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.8.0",
    "@hookform/resolvers": "^7.0.7",
    "@playwright/test": "^1.65.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@stellar/stellar-sdk": "^17.4.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/postcss": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.14.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "react-is": "^19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "axios": "^1.16.1",
    "postcss": "^8.5.10",
    "toml": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "null-loader": "^4.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1",
    "vite": "^8.3.8"
  }
}
